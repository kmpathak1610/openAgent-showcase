DATABASE_URL=postgres://openagent:openagent@localhost:5432/openagent?sslmode=disable
JWT_SECRET=change-me-to-32-random-chars-minimum
PORT=8080
LOG_LEVEL=info
ENV=development

# LLM providers (optional — stub used if keys missing)
# Generic selector (used as default when agent doesn't specify)
LLM_PROVIDER=stub
LLM_MODEL=openai/gpt-4o-mini

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# OpenRouter (recommended for single key + many models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Examples: openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-pro, meta-llama/llama-3.1-70b

# Local models (Ollama / LM Studio)
LOCAL_MODEL=llama3.1:8b
LOCAL_BASE_URL=http://localhost:11434/v1
